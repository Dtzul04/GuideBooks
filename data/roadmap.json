{
  "roadmaps": [
    {
      "id": "frontend",
      "title": "Frontend Developer",
      "description": "Build beautiful, interactive user interfaces for the web.",
      "color": "blue",
      "stages": [
        {
          "level": "Beginner",
          "title": "The Foundation",
          "topics": [
            {
              "name": "HTML5",
              "description": "Structure web pages with semantic elements",
              "resources": "MDN Web Docs",
              "status": "start-here"
            },
            {
              "name": "CSS3",
              "description": "Style and layout \u2014 flexbox, grid, responsive design",
              "resources": "CSS Tricks",
              "status": "start-here"
            },
            {
              "name": "JavaScript Basics",
              "description": "Variables, functions, loops, arrays, objects",
              "resources": "javascript.info",
              "status": "start-here"
            },
            {
              "name": "Git & GitHub",
              "description": "Version control and pushing code",
              "resources": "GitHub Docs",
              "status": "start-here"
            }
          ]
        },
        {
          "level": "Intermediate",
          "title": "Modern JavaScript & React",
          "topics": [
            {
              "name": "ES6+ JavaScript",
              "description": "Arrow functions, destructuring, async/await, modules",
              "resources": "javascript.info",
              "status": "next"
            },
            {
              "name": "React",
              "description": "Components, props, useState, useEffect",
              "resources": "react.dev",
              "status": "next"
            },
            {
              "name": "TypeScript",
              "description": "Types, interfaces, generics \u2014 safer JavaScript",
              "resources": "typescriptlang.org",
              "status": "next"
            },
            {
              "name": "Tailwind CSS",
              "description": "Utility-first CSS framework",
              "resources": "tailwindcss.com",
              "status": "next"
            },
            {
              "name": "REST APIs",
              "description": "Fetching data from backends using fetch/axios",
              "resources": "MDN Web Docs",
              "status": "next"
            }
          ]
        },
        {
          "level": "Advanced",
          "title": "Production Ready",
          "topics": [
            {
              "name": "Next.js",
              "description": "React framework with routing, SSR, and API routes",
              "resources": "nextjs.org",
              "status": "advanced"
            },
            {
              "name": "Testing",
              "description": "Unit and integration testing with Jest and Playwright",
              "resources": "jestjs.io",
              "status": "advanced"
            },
            {
              "name": "Performance Optimization",
              "description": "Lazy loading, code splitting, Web Vitals",
              "resources": "web.dev",
              "status": "advanced"
            },
            {
              "name": "Accessibility (a11y)",
              "description": "WCAG standards, screen readers, semantic HTML",
              "resources": "a11yproject.com",
              "status": "advanced"
            },
            {
              "name": "CI/CD & Deployment",
              "description": "GitHub Actions, Vercel, Netlify",
              "resources": "Vercel Docs",
              "status": "advanced"
            }
          ]
        }
      ]
    },
    {
      "id": "backend",
      "title": "Backend Developer",
      "description": "Build powerful servers, APIs, and databases that power applications.",
      "color": "green",
      "stages": [
        {
          "level": "Beginner",
          "title": "The Foundation",
          "topics": [
            {
              "name": "JavaScript or Python",
              "description": "Pick one language and learn it deeply",
              "resources": "javascript.info or cs50.harvard.edu/python",
              "status": "start-here"
            },
            {
              "name": "Git & GitHub",
              "description": "Version control for your projects",
              "resources": "GitHub Docs",
              "status": "start-here"
            },
            {
              "name": "Terminal & Linux",
              "description": "Basic commands \u2014 ls, cd, mkdir, grep, SSH",
              "resources": "linuxcommand.org",
              "status": "start-here"
            },
            {
              "name": "HTTP Basics",
              "description": "How requests and responses work",
              "resources": "MDN Web Docs",
              "status": "start-here"
            }
          ]
        },
        {
          "level": "Intermediate",
          "title": "Servers, APIs & Databases",
          "topics": [
            {
              "name": "Node.js",
              "description": "JavaScript runtime for building servers",
              "resources": "nodejs.org",
              "status": "next"
            },
            {
              "name": "Express.js",
              "description": "Build REST APIs with routes and middleware",
              "resources": "expressjs.com",
              "status": "next"
            },
            {
              "name": "SQL & PostgreSQL",
              "description": "Relational databases \u2014 SELECT, JOIN, CRUD",
