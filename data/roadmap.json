              "status": "next"
            },
            {
              "name": "Authentication",
              "description": "JWT, bcrypt, sessions, OAuth basics",
              "resources": "jwt.io",
              "status": "next"
            },
            {
              "name": "Environment Variables",
              "description": "Keeping secrets safe with .env files",
              "resources": "dotenv docs",
              "status": "next"
            }
          ]
        },
        {
          "level": "Advanced",
          "title": "Production Ready",
          "topics": [
            {
              "name": "TypeScript with Node",
              "description": "Type-safe backend development",
              "resources": "typescriptlang.org",
              "status": "advanced"
            },
            {
              "name": "Docker",
              "description": "Containerize your applications",
              "resources": "docs.docker.com",
              "status": "advanced"
            },
            {
              "name": "CI/CD",
              "description": "GitHub Actions for automated testing and deployment",
              "resources": "GitHub Actions Docs",
              "status": "advanced"
            },
            {
              "name": "Cloud Basics (AWS)",
              "description": "S3, EC2, Lambda \u2014 deploy to the cloud",
              "resources": "aws.amazon.com",
              "status": "advanced"
            },
            {
              "name": "Caching & Performance",
              "description": "Redis, rate limiting, query optimization",
              "resources": "redis.io",
              "status": "advanced"
            },
            {
              "name": "Testing",
              "description": "Unit and integration tests with Jest",
              "resources": "jestjs.io",
              "status": "advanced"
            }
          ]
        }
      ]
    },
